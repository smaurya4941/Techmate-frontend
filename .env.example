# Techmate Industries Frontend - Example Environment Variables
API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_APP_NAME="Techmate Industries"
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# WhatsApp number for the website chat links (country code + number, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=918008324628

# Public Google reviews page URL and write review link
NEXT_PUBLIC_GOOGLE_REVIEWS_URL="https://maps.app.goo.gl/V1CdPJFCWRszomSP6"
NEXT_PUBLIC_GOOGLE_WRITE_REVIEW_URL="https://maps.app.goo.gl/V1CdPJFCWRszomSP6"

# Optional: shared secret for the admin panel revalidation webhook (POST /api/revalidate).
# Must equal FRONTEND_REVALIDATE_SECRET in the backend .env. Leave empty to disable.
REVALIDATE_SECRET=

# Dev only: set to 1 to preview the Google reviews section with clearly labelled sample data.
# Ignored in production builds. Real data comes from the Laravel /api/v1/google-reviews endpoint.
NEXT_PUBLIC_REVIEWS_PREVIEW=
